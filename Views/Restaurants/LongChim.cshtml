@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لونق تشيم - مطل البجيري</title>

    <link rel="stylesheet" href="https://s3.ticketmx.com/fonts/NeoSansArabic/NeoSansArabic.css">
    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="~/css/longchim.css" asp-append-version="true" />
</head>

<body class="text-slate-900 leading-normal">

    <nav class="bg-white navbar-shadow sticky top-0 z-50">
        <div class="container mx-auto px-4 py-4 flex items-center justify-between">
            <div class="hidden lg:flex gap-8 items-center text-sm">
                <a href="#" class="font-bold hover:text-amber-700 transition">اتصل بنا</a>
                <a href="#" class="text-gray-400 hover:text-black">English</a>
            </div>

            <a href="/" class="flex-shrink-0">
                <img src="https://s3.ticketmx.com/bujairi/images/bujairi-ar.svg" alt="Bujairi" class="h-10 md:h-14">
            </a>

            <div class="flex items-center gap-6">
                <div class="hidden lg:flex gap-6 text-sm font-bold">
                    <a href="#" class="hover:text-amber-700">الرئيسية</a>
                    <a href="#" class="text-amber-700 border-b-2 border-amber-700 pb-1">المطاعم</a>
                    <a href="#" class="hover:text-amber-700">تذاكري</a>
                </div>
                <button class="lg:hidden p-2 text-gray-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
                </button>
            </div>
        </div>
    </nav>

    <!-- Header Section -->
    <header class="relative h-[450px] w-full bg-black">
        <img src="https://s3.ticketmx.com/uploads/images/4662cdb0543f37db5dd9dd8160c0ffba6958b026.jpg?w=1920&h=700&mode=crop"
             alt="Long Chim" class="w-full h-full object-cover opacity-80">

        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>

        <div class="absolute bottom-0 w-full pb-12">
            <div class="container mx-auto px-4 flex flex-col md:flex-row items-end gap-6">
                <div class="bg-white p-2 rounded-xl shadow-2xl z-10 hidden md:block">
                    <img src="https://s3.ticketmx.com/uploads/images/681bd55fd60c18086636e068378b27c80f591401.png?w=200"
                         alt="Long Chim Logo" class="w-32 h-32 object-contain rounded-lg">
                </div>
                <div class="text-white z-10 flex-grow">
                    <div class="flex items-center gap-3 mb-3">
                        <span class="michelin-badge text-[10px] md:text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Michelin Star</span>
                        <span class="bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-xs">تايلاندي</span>
                    </div>
                    <h1 class="text-4xl md:text-6xl font-bold">لونق تشيم</h1>
                    <p class="mt-4 text-gray-300 max-w-2xl text-lg hidden md:block">
                        يستلهم لونق تشيم، الحاصل على نجمة ميشلان، أطباقه من الأكشاك والأسواق المفتوحة في بانكوك. ويقدم خيارات متنوعة بألوان ونكهات طازجة ومميزة بلمسة عصرية.
                    </p>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-12">
        <div class="flex flex-col lg:flex-row gap-12">

            <!-- Information Side -->
            <div class="lg:w-2/3 space-y-10">

                <!-- Intro Mobile -->
                <section class="md:hidden">
                    <p class="text-gray-600 leading-relaxed text-lg italic border-r-4 border-amber-600 pr-4">
                        يستلهم لونق تشيم، الحاصل على نجمة ميشلان، أطباقه من الأكشاك والأسواق المفتوحة في بانكوك. ويقدم خيارات متنوعة بألوان ونكهات طازجة ومميزة بلمسة عصرية.
                    </p>
                </section>

                <!-- Booking Includes -->
                <section class="bg-amber-50/50 p-8 rounded-2xl border border-amber-100">
                    <h2 class="text-2xl font-bold mb-6 flex items-center gap-3">
                        <span class="bg-amber-600 w-2 h-8 rounded-full"></span>
                        ماذا يشمل الحجز؟
                    </h2>
                    <div class="grid md:grid-cols-3 gap-6">
                        <div class="flex gap-4">
                            <div class="text-amber-600">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                            <p class="text-sm font-medium">الدخول لمنطقة مطل البجيري الفاخرة.</p>
                        </div>
                        <div class="flex gap-4">
                            <div class="text-amber-600">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                            <p class="text-sm font-medium">إمكانية زيارة حي الطريف التاريخي.</p>
                        </div>
                        <div class="flex gap-4">
                            <div class="text-amber-600">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                            <p class="text-sm font-medium">استرداد قيمة الرسوم من مبلغ الفاتورة.</p>
                        </div>
                    </div>
                </section>

                <!-- Terms -->
                <section>
                    <h2 class="text-xl font-bold mb-6 text-bujairi">الشروط والأحكام</h2>
                    <div class="space-y-4 text-gray-600 text-sm">
                        <div class="flex items-start gap-3 p-4 bg-white rounded-lg shadow-sm">
                            <span class="text-amber-600 mt-1">•</span>
                            <p>يتحتم على الزوار إلغاء أو تعديل الحجوزات قبل 24 ساعة على الأقل.</p>
                        </div>
                        <div class="flex items-start gap-3 p-4 bg-white rounded-lg shadow-sm">
                            <span class="text-amber-600 mt-1">•</span>
                            <p>لا يمكن حجز الحفلات والمجموعات التي تزيد عن 8 أشخاص إلا بالاتصال بالمطعم.</p>
                        </div>
                        <div class="flex items-start gap-3 p-4 bg-white rounded-lg shadow-sm">
                            <span class="text-amber-600 mt-1">•</span>
                            <p>جميع المبالغ المدفوعة غير مستردة في حال عدم الحضور.</p>
                        </div>
                    </div>
                </section>

                <!-- Location Map -->
                <section class="h-[350px] rounded-3xl overflow-hidden shadow-lg border-4 border-white">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3623.708383732955!2d46.574309199999995!3d24.7368899!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0xe6a9b7f454b6510f!2sBujairi%20Terrace!5e0!3m2!1sen!2ssa!4v1662991281447!5m2!1sen!2ssa"
                            width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                </section>
            </div>

    <!-- Booking Side -->
    <div class="lg:w-1/3">
        <div class="bg-white rounded-3xl shadow-2xl border border-gray-100 overflow-hidden booking-sidebar">

            <div class="p-6 bg-slate-900 text-white flex justify-between items-center">
                <div>
                    <h3 class="font-bold text-xl">احجز الآن</h3>
                    <p class="text-xs text-gray-400">متاح اليوم والحجوزات المستقبلية</p>
                </div>
                <div class="text-right">
                    <span class="block text-xs uppercase text-gray-400">الحد الأدنى</span>
                    <span class="text-xl font-bold text-amber-500">50 ريال</span>
                </div>
            </div>

            <form asp-controller="Booking"
      asp-action="Create"
      method="post"
      id="bookingForm"
      class="p-8 space-y-8">


                <!-- تاريخ الحجز -->
                <div>
                    <label class="block text-sm font-bold mb-3 text-gray-700">تاريخ الحجز</label>
                    <select id="dateSelect"
                            class="w-full p-4 rounded-2xl bg-gray-50 border border-gray-200 font-medium">
                    </select>
                </div>

                <!-- عدد الضيوف -->
                <div>
                    <div class="flex items-center gap-4 bg-gray-50 p-2 rounded-2xl border border-gray-200">
                        <button type="button" onclick="stepQty(1)" class="w-12 h-12 bg-white rounded-xl text-xl font-bold">-</button>
                        <input type="number" id="guestInput"
                               value="2" min="2" max="6"
                               readonly
                               class="bg-transparent text-center font-bold text-2xl flex-grow">
                        <button type="button" onclick="stepQty(-1)" class="w-12 h-12 bg-white rounded-xl text-xl font-bold">+</button>
                    </div>
                </div>

                <!-- الأوقات -->
                <div>
                    <label class="block text-sm font-bold mb-4 text-gray-700">الأوقات المتاحة</label>
                    <div class="grid grid-cols-3 gap-3"
                         id="timeSlotsContainer">
                    </div>
                </div>

                <!-- الإجمالي -->
                <div class="pt-6 border-t space-y-3">
                    <div class="flex justify-between font-bold text-2xl">
                        <span>الإجمالي</span>
                        <span id="totalPrice">100 ريال</span>
                    </div>
                </div>
                        <input type="hidden" name="restaurantId" value="3" />
                        <input type="hidden" name="BookingDate" id="hiddenDate" />
                        <input type="hidden" name="Guests" id="hiddenGuests" />
                        <input type="hidden" name="SelectedTime" id="hiddenTime" />

                        <button type="submit"
                                id="mainBookBtn"
                                class="w-full py-5 rounded-2xl bg-bujairi text-white font-bold text-xl">
                            تأكيد الحجز
                        </button>

            </form>
        </div>
    </div>
    </main>
    <footer class="bg-slate-900 text-white py-16">
        <div class="container mx-auto px-4">
            <div class="flex flex-col md:flex-row justify-between items-center gap-8 border-b border-slate-800 pb-12">
                <img src="https://s3.ticketmx.com/bujairi/images/bujairi-ar.svg" alt="Footer Logo" class="h-12 brightness-200">
                <div class="flex gap-8 text-sm">
                    <a href="#" class="hover:text-amber-500">من نحن</a>
                    <a href="#" class="hover:text-amber-500">الأسئلة الشائعة</a>
                    <a href="#" class="hover:text-amber-500">اتصل بنا</a>
                </div>
            </div>
            <div class="flex flex-col md:flex-row justify-between items-center mt-12 text-sm text-gray-500">
                <p>Copyright 2026 DGCL. All Rights Reserved</p>
                <div class="flex items-center gap-3 mt-4 md:mt-0">
                    <img src="https://s3.ticketmx.com/bujairi/images/phone.svg" alt="phone" class="w-5">
                    <span dir="ltr">+966 92 0021 727</span>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/js/longchim.js" asp-append-version="true"></script>

</body>
</html>
