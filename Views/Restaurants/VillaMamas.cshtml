@model BujairiTic.Models.Restaurant
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Name - مطل البجيري</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/villa.css" asp-append-version="true" />
</head>

<body class="bg-gray-50 text-gray-800">

    <!-- NAV -->
    <nav class="sticky top-0 z-50 bg-white border-b border-gray-100 px-4 md:px-12 py-3 flex justify-between items-center">
        <img src="https://s3.ticketmx.com/bujairi/images/bujairi-ar.svg" class="h-10">
        <div class="hidden md:flex gap-8 text-sm font-medium">
            <a href="/" class="hover:text-amber-700">الرئيسية</a>
            <a href="/Restaurants" class="hover:text-amber-700">المطاعم</a>
            <a href="#" class="text-amber-700">حجوزاتي</a>
        </div>
    </nav>

    <!-- HERO -->
    <section class="relative h-[50vh] overflow-hidden">
        <img src="@Model.ImageUrl"
             class="w-full h-full object-cover">

        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent flex items-end p-8 text-white">
            <div class="max-w-6xl mx-auto w-full flex items-end gap-6">
                <div class="bg-white p-2 rounded-xl shadow-2xl hidden md:block">
                    <img src="@Model.LogoUrl" class="w-32 h-32 object-contain">
                </div>
                <div>
                    <span class="bg-amber-600 text-xs px-3 py-1 rounded-full">@Model.Type</span>
                    <h1 class="text-4xl font-bold mt-3">@Model.Name</h1>
                </div>
            </div>
        </div>
    </section>

    <!-- MAIN -->
    <main class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- INFO -->
        <div class="lg:col-span-2 space-y-8">

            <div class="bg-white p-6 rounded-2xl shadow-sm border">
                <h2 class="text-xl font-bold mb-4 border-r-4 border-amber-600 pr-3">عن المطعم</h2>
                <p class="text-gray-600 leading-relaxed">
                    @Model.Description
                </p>
            </div>

            <div class="bg-amber-50 p-6 rounded-2xl border">
                <h2 class="text-lg font-bold mb-4 text-amber-900">الحجز يشمل</h2>
                <ul class="space-y-2 text-amber-800 text-sm">
                    <li>الدخول لمنطقة مطل البجيري الفاخرة.</li>
                    <li>إمكانية الدخول لحي الطريف التاريخي.</li>
                    <li>استرداد قيمة رسوم الحجز من مبلغ الفاتورة.</li>
                </ul>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                <h2 class="text-xl font-bold mb-4">الشروط والأحكام</h2>
                <div class="text-sm text-gray-500 space-y-2">
                    <p>• يلتزم الضيف بالحجز والوصول في الوقت المحدد.</p>
                    <p>• جميع المبالغ المدفوعة للحجز غير مستردة.</p>
                    <p>• يرجى إلغاء أو تعديل الحجز قبل 24 ساعة على الأقل.</p>
                </div>
            </div>

        </div>

        <!-- BOOKING -->
        <div>
            <div class="sticky-booking bg-white rounded-2xl shadow-xl border border-primary border-opacity-20 overflow-hidden">

                <div class="bg-primary bg-opacity-5 p-6 border-b border-gray-100">
                    <h3 class="text-xl font-bold text-center">حجز طاولة</h3>
                </div>

                <form asp-controller="Booking"
                      asp-action="Create"
                      method="post"
                      class="p-6 space-y-6">

                    <!-- مهم جداً -->
                    <input type="hidden" name="restaurantId" value="@Model.Id" />
                    <input type="hidden" name="SelectedTime" id="selectedTimeInput" />

                    <!-- Date Picker -->
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">تاريخ الحجز</label>
                        <select name="BookingDate"
                                id="bookingDate"
                                class="w-full border rounded-xl px-4 py-3 bg-white focus:ring-2 focus:ring-primary outline-none appearance-none cursor-pointer">
                        </select>
                    </div>

                    <!-- Guests -->
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">عدد الضيوف</label>

                        <div class="flex items-center justify-between border rounded-xl px-4 py-2">

                            <button type="button"
                                    onclick="changeGuests(1)"
                                    class="w-10 h-10 rounded-full bg-primary bg-opacity-10 text-primary font-bold text-xl flex items-center justify-center hover:bg-primary hover:text-white transition">
                                +
                            </button>

                            <input type="number"
                                   id="guestCount"
                                   name="Guests"
                                   value="2"
                                   min="2"
                                   max="10"
                                   readonly
                                   class="text-center font-bold text-xl w-12 border-none focus:ring-0">

                            <button type="button"
                                    onclick="changeGuests(-1)"
                                    class="w-10 h-10 rounded-full bg-gray-100 text-gray-400 font-bold text-xl flex items-center justify-center hover:bg-gray-200 transition">
                                -
                            </button>
                        </div>

                        <p class="text-xs text-gray-400 mt-2 text-center">
                            الحد الأدنى 2 - الحد الأقصى 10 ضيوف
                        </p>
                    </div>

                    <!-- Time Slots -->
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">الأوقات المتاحة</label>
                        <div class="grid grid-cols-3 gap-2" id="timeSlots">
                        </div>
                    </div>

                    <!-- Price -->
                    <div class="bg-gray-50 p-4 rounded-xl space-y-2">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-500">رسوم الفرد الواحد</span>
                            <span>@Model.MinimumCharge ريال</span>
                        </div>

                        <div class="flex justify-between font-bold text-lg pt-2 border-t">
                            <span>الإجمالي</span>
                            <span class="text-primary">
                                <span id="totalPrice">0</span> ريال
                            </span>
                        </div>
                    </div>

                    <!-- Submit -->
                    <button type="submit"
                            class="w-full bg-primary text-white font-bold py-4 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all">
                        احجز الآن
                    </button>

                </form>
            </div>
        </div>


    </main>

    <!-- FOOTER -->
    <footer class="bg-slate-900 text-slate-400 py-12 px-6">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
            <div>
                <img src="https://s3.ticketmx.com/bujairi/images/bujairi-ar.svg"
                     class="h-10 mb-4 brightness-0 invert">
                <p class="text-sm">جميع الحقوق محفوظة شركة الدرعية 2024</p>
            </div>
            <div class="flex items-center gap-3 bg-slate-800 px-6 py-3 rounded-full border">
                <span dir="ltr">+966 92 0021 727</span>
            </div>
        </div>
    </footer>

    <script src="~/js/villa.js" asp-append-version="true"></script>

</body>
</html>
