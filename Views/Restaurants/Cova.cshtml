    <!-- Footer -->
    <div id="footer" class="footer__bujairi py-0">
        <div class="footer__contact d-flex justify-content-between flex-md-nowrap flex-wrap">
            <span class="copyright">Copyright 2024 DGCL. All Rights Reserved</span>
            <a href="tel:00966920021727" target="_blank" class="phone d-flex align-items-center mb-md-0">
                <img src="https://s3.ticketmx.com/bujairi/images/phone.svg" alt="phone" />
                <span style="direction:ltr">+966 92 0021 727</span>
            </a>
        </div>
    </div>

</body>
</html>
