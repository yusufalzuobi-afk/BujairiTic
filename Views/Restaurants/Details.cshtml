@model BujairiTic.Models.Restaurant

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5">

    <div class="row">
        <div class="col-md-6">
            <img src="@Model.ImageUrl" class="img-fluid rounded shadow" />
        </div>

        <div class="col-md-6">
            <img src="@Model.LogoUrl" width="120" class="mb-3" />

            <h2>@Model.Name</h2>
            <p class="text-muted">@Model.Type</p>

            <hr />

            <p>@Model.Description</p>

            <div class="alert alert-warning mt-4">
                الحد الأدنى للحجز: <strong>@Model.MinimumCharge ريال</strong>
            </div>

            <a asp-action="Index" class="btn btn-dark mt-3">
                رجوع
            </a>
        </div>
    </div>

</div>
