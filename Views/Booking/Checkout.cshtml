@model BujairiTic.Models.Order
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إتمام الشراء - Bujairi Terrace</title>

    <link rel="icon" href="https://s3.ticketmx.com/bujairi/images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://s3.ticketmx.com/fonts/NeoSansArabic/NeoSansArabic.css">
    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
</head>

<body class="text-slate-800 flex flex-col min-h-screen">

    <!-- Nav -->
    <nav class="bg-white border-b border-gray-100">
        <div class="container mx-auto px-4 py-3 flex items-center justify-between">
            <a href="#" class="hidden lg:block text-sm font-bold text-slate-600">اتصل بنا</a>
            <a href="/">
                <img src="https://s3.ticketmx.com/bujairi/images/bujairi-ar.svg" alt="Bujairi" class="h-10">
            </a>
            <a href="#" class="text-sm font-sans text-gray-400">English</a>
        </div>
    </nav>

    <!-- Header -->
    <header class="bg-white border-b border-gray-100 py-4 shadow-sm">
        <div class="container mx-auto px-4 flex flex-col lg:flex-row items-center justify-between gap-4">
            <h1 class="text-xl font-bold">إتمام الشراء</h1>
            <nav>
                <ul class="steps-container">
                    <li class="active">تسجيل دخول</li>
                    <li class="active">اختيار التذاكر</li>
                    <li class="active">إتمام الشراء</li>
                </ul>
            </nav>
        </div>
    </header>

    <main class="flex-grow container mx-auto px-4 py-8">
        <div class="max-w-4xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- Right Column: Summary -->
            <div class="lg:col-span-2 space-y-6">

                <!-- Timer -->
                <div class="bg-amber-50 border border-amber-100 rounded-2xl p-4 flex items-center gap-4 text-amber-800">
                    <div class="timer-badge bg-amber-200 p-2 rounded-lg">
                        ⏳
                    </div>
                    <p class="text-sm font-bold">
                        الوقت المتاح لإتمام العملية هو 10 دقائق والمتبقي:
                        <span id="countdown" class="font-mono text-lg">10:00</span>
                    </p>
                </div>

                <!-- Cart Summary -->
                <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="bg-slate-900 px-6 py-4 text-white font-bold">
                        ملخص السلة
                    </div>

                    <div class="p-6">

                        @foreach (var item in Model.Items)
                        {
                            <div class="flex flex-col md:flex-row gap-4 pb-6 border-b border-gray-100">
                                <div class="flex-grow">
                                    <h3 class="font-bold text-lg">@item.Title</h3>

                                    <div class="mt-3 flex flex-wrap gap-2">
                                        <span class="bg-slate-100 text-slate-600 px-3 py-1 rounded-full text-[10px] font-bold">
                                            @item.BookingDate.ToString("dddd dd MMMM", new System.Globalization.CultureInfo("ar-SA"))
                                        </span>

                                        @if (!string.IsNullOrEmpty(item.SelectedTime))
                                        {
                                            <span class="bg-slate-100 text-slate-600 px-3 py-1 rounded-full text-[10px] font-bold">
                                                @item.SelectedTime
                                            </span>
                                        }
                                    </div>

                                    <p class="text-sm font-bold mt-4">
                                        الكمية: @item.Guests
                                    </p>
                                </div>

                                <div class="text-left md:text-right">
                                    <span class="text-xl font-bold text-bujairi">
                                        @item.LineTotal ريال
                                    </span>
                                </div>
                            </div>
                        }

                        <!-- Total -->
                        <div class="flex items-center justify-between pt-6">
                            <span class="text-xl font-bold">الإجمالي</span>
                            <span class="text-2xl font-bold">
                                @Model.Items.Sum(i => i.LineTotal) ريال
                            </span>
                        </div>

                    </div>
                </div>

                <!-- Coupon -->
                <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6">
                    <h4 class="font-bold mb-4">كود الخصم</h4>
                    <div class="flex gap-2">
                        <input type="text" id="couponInput"
                               placeholder="أدخل كود الخصم"
                               class="flex-grow bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-bujairi transition">

                        <button type="button"
                                onclick="applyCoupon()"
                                class="bg-slate-800 text-white px-8 py-3 rounded-xl font-bold hover:bg-slate-700 transition">
                            تفعيل
                        </button>
                    </div>
                </div>

            </div>

            <!-- Left Column: Payment -->
            <div class="lg:col-span-1">
                <form asp-action="SavePaymentMethod"
                      method="post"
                      class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 sticky top-24">

                    <input type="hidden" name="id" value="@Model.Id" />

                    <h4 class="font-bold mb-6">طريقة الدفع</h4>

                    <div class="space-y-3">

                        <label class="payment-card flex items-center justify-between p-4 rounded-2xl border-gray-100 border-2">
                            <div class="flex items-center gap-3">
                                <span class="text-sm font-bold">Apple Pay</span>
                            </div>
                            <div class="flex items-center gap-3">
                            <img src="https://s3.ticketmx.com/img/apple-pay.png" class="h-6" alt="Apple Pay">
                            <input type="radio" name="method" value="Apple Pay" />
                            </div>
                        </label>

                        <label class="payment-card selected flex items-center justify-between p-4 rounded-2xl border-gray-100 border-2">
                            <div class="flex items-center gap-3">
                                <span class="text-sm font-bold">فيزا / ماستر كارد</span>
                            </div>
                            <div class="flex gap-1">
                                <img src="https://s3.ticketmx.com/img/visa.png" class="h-4" alt="Visa">
                                <img src="https://s3.ticketmx.com/img/mastercard.png" class="h-4" alt="Mastercard">
                            </div>
                            <input type="radio" name="method" value="Credit Card" checked />
                        </label>

                        <label class="payment-card flex items-center justify-between p-4 rounded-2xl border-gray-100 border-2">
                            <div class="flex items-center gap-3">
                                <span class="text-sm font-bold">بطاقة مدى</span>
                               
                            </div>
                            <div class="flex items-center gap-3">
                                <img src="https://s3.ticketmx.com/img/mada.png" class="h-4" alt="Mada">
                                </div>
                                
                           
                            <input type="radio" name="method" value="Mada" />
                        </label>

                        <label class="payment-card flex items-center justify-between p-4 rounded-2xl border-gray-100 border-2">
                            <div class="flex items-center gap-3">
                                <span class="text-sm font-bold">STC Pay</span>

                            </div>
                            <div class="flex items-center gap-3">
                                <img src="https://s3.ticketmx.com/img/stc-pay.png" class="h-6" alt="STC Pay">
                              
                            </div>
                            <input type="radio" name="method" value="STC Pay" />
                        </label>

                    </div>

                    <button type="submit"
                            class="w-full mt-8 py-4 bg-bujairi hover:bg-amber-700 text-white font-bold rounded-xl transition-all shadow-lg shadow-amber-900/10">
                        تأكيد الدفع
                    </button>

                    <p class="text-[10px] text-gray-400 text-center mt-4">
                        بالضغط على زر الدفع أنت توافق على الشروط والأحكام.
                    </p>

                </form>
            </div>

        </div>
    </main>

    <footer class="bg-white border-t border-gray-100 py-6 mt-12">
        <div class="container mx-auto px-4 flex justify-between items-center text-[10px] text-gray-400">
            <span>Copyright 2024 DGCL. All Rights Reserved</span>
            <span dir="ltr">+966 92 0021 727</span>
        </div>
    </footer>

    <script src="~/js/checkout.js" asp-append-version="true"></script>

</body>
</html>
