<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Bujairi</title>

    <link rel="icon" href="https://s3.ticketmx.com/bujairi/images/favicon.ico">

    <link rel="stylesheet" href="https://s3.ticketmx.com/fonts/NeoSansArabic/NeoSansArabic.css">

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>

<body class="bg-[#f5f3ef] text-gray-800">

    @await Html.PartialAsync("_Navbar")

    <main class="pt-12">
        @RenderBody()
    </main>

    <script>
        window.isFakeUserLogged = '@(Context.Session.GetString("FAKE_USER") != null ? "true" : "false")';
    </script>

</body>
</html>
