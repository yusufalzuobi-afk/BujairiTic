@using Microsoft.AspNetCore.Http

<nav class="navbar navbar-expand-lg bg-primary flex-wrap nav__bujairi">
    <div class="d-flex align-items-center justify-content-lg-between justify-content-center w-100 py-3 top__nav">
        <a class="nav-link d-lg-block d-none" href="/ar/ContactUs">اتصل بنا</a>

        <a class="navbar-brand" href="/ar">
            <img src="https://s3.ticketmx.com/bujairi/images/bujairi-ar.svg" alt="Bujairi Logo" class="logo" />
        </a>

        <a class="nav-link other-font languageLink d-lg-block d-none" href="/en">English</a>
    </div>

    <hr class="hr" />

    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon">
            <img src="https://s3.ticketmx.com/bujairi/images/btn-menu.svg" alt="menu" class="menu-icon">
        </span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav justify-content-lg-center justify-content-start d-lg-flex d-block w-100">
            <li class="nav-item">
                <a class="nav-link" href="https://www.bujairi.sa/ar">الرئيسية</a>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="#bookingSection">خيارات الحجز</a>
            </li>

            <li class="nav-item">
                <a class="nav-link" asp-controller="Restaurants" asp-action="Restaurants">المطاعم</a>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="/ar/Orders">تذاكري</a>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="/ar/Orders/Bookings">حجوزاتي</a>
            </li>

            <li class="nav-item">
                <a class="gtmLink nav-link" href="/ar/Account/Profile">حسابي</a>
            </li>

            <li class="nav-item">
                <a class="gtmLink nav-link" href="/ar/Wallet">محفظتي</a>
            </li>

            @if (Context.Session.GetString("FAKE_USER") == null)
            {
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Login", "Account")">تسجيل الدخول</a>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Logout", "Account")">تسجيل خروج</a>
                </li>
            }

            <li class="nav-item d-lg-none d-block">
                <a class="nav-link" href="/ar/ContactUs">اتصل بنا</a>
            </li>

            <li class="nav-item d-lg-none d-block">
                <a class="nav-link other-font languageLink" href="/en">English</a>
            </li>
        </ul>
    </div>

    <hr class="hr" />
</nav>

<input type="hidden" value="ar" id="hiddenLang" />
