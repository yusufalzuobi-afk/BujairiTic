    <script type="text/javascript">
        $(function () {
            var language = "ar";
            var language2 = "en";
            var pathname = window.location.href;
            var regex = new RegExp("/" + language + "/", "i");
            if (regex.test(pathname)) {
                $('.languageLink').attr("href", pathname.replace(regex, "/" + language2 + "/"));
            }
        });
    </script>
    <script type="text/javascript">
